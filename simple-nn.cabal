cabal-version:      2.0
name:               simple-nn
version:            0.1.0.0
synopsis:           A small feed-forward neural network with backpropagation in Haskell
license:            MIT
build-type:         Simple

common warnings
    ghc-options: -Wall

library
    import:           warnings
    hs-source-dirs:   src
    exposed-modules:  NN
                    , NN.Activation
                    , NN.Backward
                    , NN.Cost
                    , NN.Forward
                    , NN.Network
                    , NN.Neuron
                    , NN.Train
    build-depends:    base
                    , split
                    , random
    default-language: Haskell2010

executable simple-nn
    import:           warnings
    main-is:          Main.hs
    hs-source-dirs:   src
    build-depends:    base
                    , simple-nn
    default-language: Haskell2010

test-suite nn-tests
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Tests.hs
    hs-source-dirs:   test
    build-depends:    base
                    , simple-nn
                    , random
    default-language: Haskell2010
